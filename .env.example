# Copie para a Vercel (ou .env local) preenchendo com as chaves do SEU Supabase.

# --- Cliente (público, prefixo VITE_) ---
VITE_SUPABASE_URL=https://SEU_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_ANON_KEY
VITE_SUPABASE_PROJECT_ID=SEU_REF

# --- Servidor (nunca use prefixo VITE_) ---
SUPABASE_URL=https://SEU_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=SUA_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
MERCADOPAGO_ACCESS_TOKEN=SEU_TOKEN_MERCADO_PAGO
